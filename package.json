{
  "name": "serverlaunch",
  "version": "1.0.0",
  "description": "ServerLaunch - AWS EC2 Instance Manager",
  "main": "main.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "app": "npm run build && env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1048.0",
    "@aws-sdk/client-ec2": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^6.0.0",
    "electron": "^39.8.10",
    "style-loader": "^3.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  }
}
